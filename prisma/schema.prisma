  totalDiscount    Int             @default(0)
  transactionCount Int             @default(0)
  returnCount      Int             @default(0)
  notes            String?
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  entries          PosShiftEntry[]
  orders           Order[]
  returns          PosReturn[]

  @@index([storeId, status])
  @@index([cashierId, openedAt])
  @@index([storeId, openedAt])
  @@index([branchId, status])
  @@index([branchId, openedAt])
}

model PosShiftEntry {
  id        String            @id @default(uuid())
  shiftId   String
  shift     PosShift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      PosShiftEntryType
  amount    Int
  note      String?
  createdAt DateTime          @default(now())

  @@index([shiftId, createdAt])
}

model PosHeldOrder {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierId String
  cashier   User     @relation("CashierHeldOrders", fields: [cashierId], references: [id])
  label     String?
  note      String?
  cartData  Json
  itemCount Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, cashierId])
  @@index([storeId, createdAt])
  @@index([branchId, createdAt])
}

model PosSplitPayment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod String
  amount        Int
  reference     String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model PosReturn {
  id              String          @id @default(uuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Branch the goods went back into (the original sale's branch).
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Shift whose drawer paid the refund.
  shiftId         String?
  shift           PosShift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  originalOrderId String
  originalOrder   Order           @relation("OriginalOrderReturns", fields: [originalOrderId], references: [id])
  cashierId       String?
  cashier         User?           @relation("CashierReturns", fields: [cashierId], references: [id])
  type            PosReturnType
  status          PosReturnStatus @default(PENDING)
  reason          String?
  refundAmount    Int
  refundMethod    String?
  exchangeOrderId String?         @unique
  notes           String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  items           PosReturnItem[]

  @@index([storeId, createdAt])
  @@index([originalOrderId])
  @@index([branchId, createdAt])
  @@index([shiftId])
}

model PosReturnItem {
  id        String    @id @default(uuid())
  returnId  String
  return    PosReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  reason    String?

  @@index([returnId])
}

model StockMovement {
  id          String            @id @default(uuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type        StockMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reference   String?
  note        String?
  userId      String?
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, type, createdAt])
  @@index([variantId, createdAt])
  @@index([branchId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Inventory Management System
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
