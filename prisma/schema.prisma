generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  SALES // sales representative — created only by an admin (actions/admin/sales.actions.ts)
}

enum StoreRole {
  STORE_OWNER
  STORE_MANAGER
  STORE_STAFF
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  /// Not unique in the DB so allow-listed team phones can repeat
  /// (lib/auth/multi-account); registration rejects every other duplicate.
  phone_number           String?
  password               String?
  passwordAlgo           String? // "argon2id" | "bcrypt" — for migration
  googleId               String?                 @unique
  name                   String?
  country                String?
  businessType           String?
  role                   UserRole                @default(USER)
  /// Merchant dashboard UI language: "ar" | "en".
  locale                 String                  @default("ar")
  emailVerified          Boolean                 @default(false)
  /// Set on email/password signup: the app stays locked until the emailed
  /// code is entered (lib/auth/email-verification). Older accounts only see a banner.
  mustVerifyEmail        Boolean                 @default(false)
  emailVerificationCodes EmailVerificationCode[]
  stores                 Store[]
  createdAt              DateTime                @default(now())
  cartItems              CartItem[]
  orders                 Order[]
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  loginAttempts          LoginAttempt[]
  securityLogs           SecurityLog[]
  supportRequests        SupportRequest[]
  notifications          Notification[]
  storeMembers           StoreMember[]
  sentInvitations        StoreInvitation[]       @relation("SentInvitations")
  cashierOrders          Order[]                 @relation("CashierOrders")
  posShifts              PosShift[]              @relation("CashierShifts")
  heldOrders             PosHeldOrder[]          @relation("CashierHeldOrders")
  cashierReturns         PosReturn[]             @relation("CashierReturns")

  createdPurchaseOrders PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  createdTransfers      StockTransfer[]       @relation("TransferCreatedBy")
  approvedTransfers     StockTransfer[]       @relation("TransferApprovedBy")
  inventoryAdjustments  InventoryAdjustment[]

  // Referral system
  referralCode                String?               @unique
  referredById                String?
  referredBy                  User?                 @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                   User[]                @relation("UserReferrals")
  referralCredits             Int                   @default(0)
  referralTransactionsSent    ReferralTransaction[] @relation("ReferrerTransactions")
  referralTransactionReceived ReferralTransaction?  @relation("ReferredUserTransaction")

  // Tiered referral system
  referralSuccessfulPayments Int                 @default(0)
  freeMonthsEarned           Int                 @default(0)
  referralLevel              String              @default("BRONZE")
  referralRewardLogs         ReferralRewardLog[]

  planAuditLogs PlanAuditLog[]

  // Sales team (lib/sales): the rep profile when role = SALES, and the rep
  // this account was attributed to when it signed up as a merchant.
  salesRep         SalesRep?         @relation("SalesRepUser")
  salesAttribution SalesAttribution? @relation("SalesAttributionCustomer")

  @@index([phone_number])
}

model ReferralRewardLog {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation(fields: [referrerId], references: [id])
  triggeredAt DateTime @default(now())
  type        String // "FREE_MONTH" | "LEVEL_UP"
  metadata    Json?

  @@index([referrerId])
}

model ReferralTransaction {
  id             String   @id @default(uuid())
  referrerId     String
  referrer       User     @relation("ReferrerTransactions", fields: [referrerId], references: [id])
  referredUserId String   @unique
  referredUser   User     @relation("ReferredUserTransaction", fields: [referredUserId], references: [id])
  amount         Int      @default(500)
  storeId        String
  createdAt      DateTime @default(now())

  @@index([referrerId])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// 6-digit email confirmation codes (lib/auth/email-verification). Only the
/// hash is stored; rows also drive the resend rate limit.
model EmailVerificationCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  /// Wrong guesses against this code; it stops working after the limit.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Every notification email (lib/notifications/email/deliver): what went where,
/// and whether it arrived at the SMTP server. Also dedupes alerts by kind + refId.
model EmailLog {
  id        String   @id @default(uuid())
  storeId   String?
  /// ORDER_NEW | ORDER_CONFIRMATION | ORDER_STATUS | LOW_STOCK | OUT_OF_STOCK | PAYMENT_FAILED
  kind      String
  /// The order or product the email is about.
  refId     String?
  to        String
  subject   String
  /// SENT | FAILED
  status    String
  attempts  Int
  error     String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([kind, refId, createdAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  success   Boolean
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String // LOGIN_SUCCESS | LOGIN_FAILURE | LOGOUT | PASSWORD_CHANGED | PASSWORD_RESET_REQUESTED | ACCOUNT_LOCKED | SESSION_REVOKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model Store {
  id   String @id @default(uuid())
  name String
  slug String @unique

  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionEndsAt DateTime?
  gracePeriodEndsAt  DateTime?
  autoRenew          Boolean            @default(true)

  balance        Int      @default(0)
  monthlyPrice   Int      @default(29900)
  planName       String   @default("SUPER")
  planSelected   Boolean  @default(false)
  paymentMethods String[] @default([])

  planId       String?
  plan         Plan?        @relation(fields: [planId], references: [id])
  billingCycle BillingCycle @default(MONTHLY)

  planAuditLogs PlanAuditLog[]

  userId String
  user   User   @relation(fields: [userId], references: [id])

  products       Product[]
  cartItems      CartItem[]
  orders         Order[]
  categories     Category[]
  banners        Banner[]
  popups         StorePopup[]
  cartRecoveries CartRecovery[]
  settings       StoreSettings?
  visits         Visit[]

  balanceTransactions BalanceTransaction[]
  topupRequests       TopupRequest[]
  serviceRequests     ServiceRequest[]

  coupons        Coupon[]
  appliedCoupons AppliedCoupon[]
  productOffers  ProductOffer[]

  shippingMethods      ShippingMethod[]
  customers            Customer[]
  appliedLoyaltyPoints AppliedLoyaltyPoints[]

  trialStartDate      DateTime?
  trialEndDate        DateTime?
  onboardingCompleted Boolean   @default(false)
  businessCategory    String?

  showPoweredByCasho      Boolean @default(true)
  poweredByRemovalEnabled Boolean @default(false)

  createdAt            DateTime              @default(now())
  supportRequests      SupportRequest[]
  storePaymentSettings StorePaymentSettings?
  pixelSettings        StorePixelSettings?
  blockedPhones        BlockedPhone[]
  notifications        Notification[]

  customDomain            String?            @unique
  customDomainStatus      CustomDomainStatus @default(PENDING)
  customDomainConnectedAt DateTime?

  instagramConnection InstagramConnection?
  suggestedOrders     SuggestedOrder[]
  igAiUsageLogs       IgAiUsageLog[]
  reviews             ProductReview[]

  members     StoreMember[]
  invitations StoreInvitation[]

  posShifts      PosShift[]
  heldOrders     PosHeldOrder[]
  posReturns     PosReturn[]
  stockMovements StockMovement[]

  branches             Branch[]
  branchInventory      BranchInventory[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  stockTransfers       StockTransfer[]
  inventoryAdjustments InventoryAdjustment[]
  productVariants      ProductVariant[]
  productSuppliers     ProductSupplier[]
  purchaseOrderItems   PurchaseOrderItem[]
  transferItems        StockTransferItem[]
  adjustmentItems      InventoryAdjustmentItem[]

  customerNotes    CustomerNote[]
  customerWalletTx CustomerWalletTransaction[]
  customerTimeline CustomerTimeline[]
  customerTags     CustomerTag[]
  customerSegments CustomerSegment[]

  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  shipments            Shipment[]
  apiRequestLogs       ApiRequestLog[]
  shippingIntegrations ShippingIntegration[]

  importConnections ImportConnection[]
  importJobs        ImportJob[]
  importRecords     ImportRecordMap[]

  sharksApplications SharksApplication[]

  @@index([userId])
  @@index([subscriptionStatus])
  @@index([subscriptionEndsAt])
  @@index([gracePeriodEndsAt])
}

model StoreSettings {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  themeId        String  @default("default")
  fontId         String  @default("cairo")
  storeLanguage  String  @default("ar")
  logo           String?
  logoRadius     Int     @default(8)
  logoSize       Int     @default(80)
  coverImage     String?
  primaryColor   String?
  secondaryColor String?
  navbarVariant  String  @default("default")
  shippingPrice  Int     @default(0)

  defaultLowStockThreshold Int @default(5)

  loyaltyEnabled             Boolean @default(false)
  loyaltyPointsPerEGP        Float   @default(1)
  loyaltyPointsValuePiasters Int     @default(1)
  loyaltyMinRedemption       Int     @default(100)

  /// Fake-order protection (lib/fraud). OTP needs Twilio Verify configured.
  orderOtpMode        OrderOtpMode @default(OFF)
  /// Refuse cash/manual-payment orders from HIGH-risk numbers outright.
  blockHighRiskOrders Boolean      @default(false)

  /// Full merchant theme customization (ThemeCustomization JSON).
  /// Stores presetId + tokenOverrides + layoutOverrides + sectionOverrides.
  /// When present, takes precedence over themeId / primaryColor / secondaryColor.
  themeConfig Json?

  /// Unpublished draft of the theme customization.
  /// The merchant can preview this before publishing to themeConfig.
  draftThemeConfig Json?

  seoTitle               String?
  seoDescription         String?
  seoKeywords            String[]
  ogTitle                String?
  ogDescription          String?
  ogImage                String?
  isIndexed              Boolean  @default(true)
  /// Google Search Console HTML-tag verification code (the `content` value only).
  googleSiteVerification String?

  showStoreName Boolean @default(true)

  /// Storefront conversion widgets (WhatsApp button, live purchase toasts…).
  /// Shape: ConversionConfig in lib/conversion/conversion-config.ts
  conversionConfig Json?

  announcementText String?
  description      String?
  email            String?
  whatsappNumber   String?
  instagram        String?
  facebook         String?
  tiktok           String?

  telegramChatId    String?
  telegramLinkToken String?

  /// Order emails (lib/notifications/email): every new order to the owner,
  /// confirmation + status updates to customers who left an email.
  emailNewOrders      Boolean @default(true)
  emailCustomerOrders Boolean @default(true)
  /// Low stock and failed online payments, to the owner.
  emailStoreAlerts    Boolean @default(true)

  /// Merchant paused the store until this time (lib/store/pause.ts): the
  /// storefront shows a closed page and takes no orders. Past = open.
  pausedUntil    DateTime?
  /// Shown on the closed page; null = the default text.
  pauseMessage   String?
  /// Show a countdown to `pausedUntil` on the closed page.
  pauseCountdown Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())

  ip        String?
  userAgent String?

  @@index([storeId, createdAt])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String
  image     String?
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]
  banners   Banner[]
  createdAt DateTime  @default(now())

  @@unique([storeId, slug])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  price          Float
  compareAtPrice Float?
  costPrice      Float?

  image  String   @default("/images/product-placeholder.png")
  images String[] @default([])

  brand String?

  stock             Int  @default(0)
  lowStockThreshold Int?

  sku     String?
  barcode String?

  sizes  String[] @default([])
  colors String[] @default([])
  tags   String[] @default([])

  weight     Float?
  attributes Json?

  wholesaleOptions Json?

  type        ProductType @default(SIMPLE)
  bundleItems Json?

  /// Digital product: no shipping and no stock. `digitalUrl` (an uploaded file
  /// or an external link) unlocks on the customer's order page once paid.
  isDigital       Boolean @default(false)
  digitalUrl      String?
  /// Shown on the download button when `digitalUrl` is an uploaded file.
  digitalFileName String?

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  hasVariants Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems           CartItem[]
  orderItems          OrderItem[]
  suggestedOrderItems SuggestedOrderItem[]
  reviews             ProductReview[]
  returnItems         PosReturnItem[]
  stockMovements      StockMovement[]

  variants           ProductVariant[]
  banners            Banner[]
  suppliers          ProductSupplier[]
  branchInventory    BranchInventory[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  adjustmentItems    InventoryAdjustmentItem[]
  offeredIn          ProductOffer[]

  @@index([storeId, isActive])
  @@index([storeId, isActive, createdAt])
  @@index([storeId, barcode])
  @@index([storeId, sku])
  @@index([categoryId])
  @@index([storeId, categoryId, isActive])
}

/// Where a banner sends the shopper. Resolved to a URL at render time
/// (lib/banners/banner-link.ts), so renaming a product/category never breaks it.
enum BannerLinkType {
  NONE // image only, not clickable
  PRODUCTS // all products
  FEATURED // featured products
  CATEGORY // linkCategoryId
  PRODUCT // linkProductId
  SEARCH // linkValue = search keyword
  PAGE // linkValue = store page key (categories, about, contact)
  WHATSAPP // linkValue = prefilled message, sent to the store's WhatsApp
  URL // linkValue = absolute URL or store-relative path
}

model Banner {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  title       String
  subtitle    String?
  /// Button text; themes fall back to "تسوق الآن".
  ctaLabel    String?
  image       String
  /// Optional portrait/square art shown on phones instead of `image`.
  mobileImage String?
  isActive    Boolean @default(true)
  /// Display order, ascending (0 = first slide).
  position    Int     @default(0)

  linkType       BannerLinkType @default(PRODUCTS)
  linkCategoryId String?
  linkCategory   Category?      @relation(fields: [linkCategoryId], references: [id], onDelete: SetNull)
  linkProductId  String?
  linkProduct    Product?       @relation(fields: [linkProductId], references: [id], onDelete: SetNull)
  linkValue      String?
  openInNewTab   Boolean        @default(false)

  /// Optional schedule window; the storefront shows the banner only inside it.
  startsAt DateTime?
  endsAt   DateTime?

  clicks Int @default(0)

  createdAt DateTime @default(now())

  @@index([storeId, isActive])
  @@index([storeId, position])
}

/// Marketing popup shown on the storefront (discount reveal, lead capture, announcement).
/// Content/design/trigger settings live in `config` (PopupConfig in lib/popups/popup-config.ts).
model StorePopup {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name     String
  type     String  @default("discount")
  isActive Boolean @default(false)
  priority Int     @default(0)
  config   Json

  startsAt DateTime?
  endsAt   DateTime?

  views       Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive])
}

/// Contact + recovery state for a guest cart (one per store × guest session).
/// Contact details are captured while the customer types them at checkout.
model CartRecovery {
  id             String @id @default(uuid())
  storeId        String
  store          Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  guestSessionId String

  fullName String?
  phone    String?
  address  String?

  /// Public token for the "restore my cart" link.
  token             String  @unique
  /// Session the cart was restored into (another device) — still counts as recovered.
  restoredSessionId String?

  contactedAt  DateTime?
  contactCount Int       @default(0)
  convertedAt  DateTime?
  orderId      String?
  /// Order total in piasters.
  orderTotal   Int?
  dismissedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, guestSessionId])
  @@index([storeId, updatedAt])
  @@index([restoredSessionId])
}

model CartItem {
  id             String @id @default(uuid())
  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity         Int   @default(1)
  selectedFeatures Json?

  /// Added by accepting an upsell / cross-sell / downsell — priced by the offer
  /// while it stays valid (lib/offers/offer-pricing.ts).
  offerId String?
  offer   ProductOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([guestSessionId, storeId])
  @@index([storeId])
  @@index([productId])
  @@index([userId])
}

model Coupon {
  id          String     @id @default(uuid())
  code        String
  type        CouponType
  value       Float
  isActive    Boolean    @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  minSubtotal Float?
  maxDiscount Float?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  appliedCoupons AppliedCoupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId, code, isActive])
}

/// UPSELL     — after adding a trigger product: "upgrade to this instead" (replaces it).
/// CROSS_SELL — after adding / in the cart: "goes well with" (added next to it).
/// DOWNSELL   — shown when the shopper says no to an upsell: a cheaper extra.
enum ProductOfferType {
  UPSELL
  CROSS_SELL
  DOWNSELL
}

enum OfferDiscountType {
  NONE
  PERCENTAGE
  FIXED
}

/// Merchant-made upsell / cross-sell / downsell (dashboard: /offers).
model ProductOffer {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  type     ProductOfferType
  /// Internal name in the dashboard.
  name     String
  /// What the shopper reads; a default per type when empty.
  headline String?
  isActive Boolean          @default(true)
  priority Int              @default(0)

  /// Products that trigger the offer. Empty = any product.
  triggerProductIds String[] @default([])

  offerProductId String
  offerProduct   Product @relation(fields: [offerProductId], references: [id], onDelete: Cascade)

  discountType  OfferDiscountType @default(NONE)
  /// Percent, or pounds off each piece for FIXED.
  discountValue Float             @default(0)

  views   Int @default(0)
  accepts Int @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive, type])
  @@index([offerProductId])
}

model AppliedCoupon {
  id             String @id @default(uuid())
  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guestSessionId, storeId])
  @@index([couponId])
}

model ShippingMethod {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  price         Int
  description   String?
  estimatedDays Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  orders           Order[]
  governorateRates ShippingGovernorateRate[]

  @@index([storeId, isActive])
}

/// Per-governorate price override for a shipping method (lib/shipping/governorate-pricing).
/// Governorates without a row pay the method's default `price`.
model ShippingGovernorateRate {
  id               String         @id @default(uuid())
  shippingMethodId String
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  /// Code from constants/egypt-governorates.ts
  governorate      String
  /// Piasters
  price            Int

  @@unique([shippingMethodId, governorate])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  VIP
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  REWARD
}

enum CustomerTimelineEventType {
  ORDER_PLACED
  ORDER_RETURNED
  ORDER_CANCELED
  POINTS_EARNED
  POINTS_REDEEMED
  POINTS_ADJUSTED
  WALLET_CREDITED
  WALLET_DEBITED
  TAG_ADDED
  TAG_REMOVED
  NOTE_ADDED
  PROFILE_UPDATED
  REFERRAL_MADE
}

enum SegmentType {
  MANUAL
  AUTOMATIC
}

model Customer {
  id            String         @id @default(uuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phone         String
  name          String?
  email         String?
  address       String?
  birthday      DateTime?
  notes         String?
  points        Int            @default(0)
  walletBalance Int            @default(0)
  referralCode  String?        @unique
  referredById  String?
  status        CustomerStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  appliedLoyalty      AppliedLoyaltyPoints[]
  walletTransactions  CustomerWalletTransaction[]
  staffNotes          CustomerNote[]
  timeline            CustomerTimeline[]
  tags                CustomerTagAssignment[]
  segmentMemberships  CustomerSegmentMembership[]
  referredBy          Customer?                   @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           Customer[]                  @relation("CustomerReferrals")

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  content    String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
}

model CustomerWalletTransaction {
  id            String                @id @default(uuid())
  customerId    String
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type          WalletTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String?
  reference     String?
  createdAt     DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
}

model CustomerTimeline {
