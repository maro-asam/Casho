generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum StoreRole {
  STORE_OWNER
  STORE_MANAGER
  STORE_STAFF
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  phone_number        String?              @unique
  password            String?
  passwordAlgo        String?              // "argon2id" | "bcrypt" — for migration
  googleId            String?              @unique
  name                String?
  country             String?
  businessType        String?
  role                UserRole             @default(USER)
  emailVerified       Boolean              @default(false)
  stores              Store[]
  createdAt           DateTime             @default(now())
  cartItems           CartItem[]
  orders              Order[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  loginAttempts       LoginAttempt[]
  securityLogs        SecurityLog[]
  supportRequests     SupportRequest[]
  notifications       Notification[]
  storeMembers        StoreMember[]
  sentInvitations     StoreInvitation[]    @relation("SentInvitations")
  cashierOrders       Order[]              @relation("CashierOrders")
  posShifts           PosShift[]           @relation("CashierShifts")
  heldOrders          PosHeldOrder[]       @relation("CashierHeldOrders")
  cashierReturns      PosReturn[]          @relation("CashierReturns")

  createdPurchaseOrders  PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  createdTransfers       StockTransfer[]      @relation("TransferCreatedBy")
  approvedTransfers      StockTransfer[]      @relation("TransferApprovedBy")
  inventoryAdjustments   InventoryAdjustment[]

  // Referral system
  referralCode                 String?               @unique
  referredById                 String?
  referredBy                   User?                 @relation("UserReferrals", fields: [referredById], references: [id])
  referrals                    User[]                @relation("UserReferrals")
  referralCredits              Int                   @default(0)
  referralTransactionsSent     ReferralTransaction[] @relation("ReferrerTransactions")
  referralTransactionReceived  ReferralTransaction?  @relation("ReferredUserTransaction")

  // Tiered referral system
  referralSuccessfulPayments   Int                   @default(0)
  freeMonthsEarned             Int                   @default(0)
  referralLevel                String                @default("BRONZE")
  referralRewardLogs           ReferralRewardLog[]
}

model ReferralRewardLog {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation(fields: [referrerId], references: [id])
  triggeredAt DateTime @default(now())
  type        String   // "FREE_MONTH" | "LEVEL_UP"
  metadata    Json?

  @@index([referrerId])
}

model ReferralTransaction {
  id             String   @id @default(uuid())
  referrerId     String
  referrer       User     @relation("ReferrerTransactions", fields: [referrerId], references: [id])
  referredUserId String   @unique
  referredUser   User     @relation("ReferredUserTransaction", fields: [referredUserId], references: [id])
  amount         Int      @default(500)
  storeId        String
  createdAt      DateTime @default(now())

  @@index([referrerId])
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  success   Boolean
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String   // LOGIN_SUCCESS | LOGIN_FAILURE | LOGOUT | PASSWORD_CHANGED | PASSWORD_RESET_REQUESTED | ACCOUNT_LOCKED | SESSION_REVOKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model Store {
  id   String @id @default(uuid())
  name String
  slug String @unique

  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionEndsAt DateTime?
  gracePeriodEndsAt  DateTime?
  autoRenew          Boolean            @default(true)

  balance        Int      @default(0)
  monthlyPrice   Int      @default(29900)
  planName       String   @default("SUPER")
  planSelected   Boolean  @default(false)
  paymentMethods String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  products   Product[]
  cartItems  CartItem[]
  orders     Order[]
  categories Category[]
  banners    Banner[]
  settings   StoreSettings?
  visits     Visit[]

  balanceTransactions BalanceTransaction[]
  topupRequests       TopupRequest[]
  serviceRequests     ServiceRequest[]

  coupons        Coupon[]
  appliedCoupons AppliedCoupon[]

  shippingMethods      ShippingMethod[]
  customers            Customer[]
  appliedLoyaltyPoints AppliedLoyaltyPoints[]

  trialStartDate      DateTime?
  trialEndDate        DateTime?
  onboardingCompleted Boolean   @default(false)
  businessCategory    String?

  showPoweredByCasho      Boolean @default(true)
  poweredByRemovalEnabled Boolean @default(false)

  createdAt            DateTime              @default(now())
  supportRequests      SupportRequest[]
  storePaymentSettings StorePaymentSettings?
  notifications        Notification[]

  customDomain           String?             @unique
  customDomainStatus     CustomDomainStatus  @default(PENDING)
  customDomainConnectedAt DateTime?

  instagramConnection  InstagramConnection?
  suggestedOrders      SuggestedOrder[]
  igAiUsageLogs        IgAiUsageLog[]
  reviews              ProductReview[]

  members     StoreMember[]
  invitations StoreInvitation[]

  posShifts      PosShift[]
  heldOrders     PosHeldOrder[]
  posReturns     PosReturn[]
  stockMovements StockMovement[]

  branches           Branch[]
  branchInventory    BranchInventory[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  stockTransfers     StockTransfer[]
  inventoryAdjustments InventoryAdjustment[]
  productVariants    ProductVariant[]
  productSuppliers   ProductSupplier[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  adjustmentItems    InventoryAdjustmentItem[]

  customerNotes       CustomerNote[]
  customerWalletTx    CustomerWalletTransaction[]
  customerTimeline    CustomerTimeline[]
  customerTags        CustomerTag[]
  customerSegments    CustomerSegment[]

  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  shipments             Shipment[]
  apiRequestLogs        ApiRequestLog[]
  shippingIntegrations  ShippingIntegration[]

  @@index([userId])
  @@index([subscriptionStatus])
  @@index([subscriptionEndsAt])
  @@index([gracePeriodEndsAt])
}

model StoreSettings {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  themeId        String  @default("default")
  fontId         String  @default("cairo")
  storeLanguage  String  @default("ar")
  logo           String?
  logoRadius     Int     @default(8)
  logoSize       Int     @default(80)
  coverImage     String?
  primaryColor   String?
  secondaryColor String?
  navbarVariant  String  @default("default")
  shippingPrice  Int     @default(0)

  defaultLowStockThreshold Int @default(5)

  loyaltyEnabled             Boolean @default(false)
  loyaltyPointsPerEGP        Float   @default(1)
  loyaltyPointsValuePiasters Int     @default(1)
  loyaltyMinRedemption       Int     @default(100)

  /// Full merchant theme customization (ThemeCustomization JSON).
  /// Stores presetId + tokenOverrides + layoutOverrides + sectionOverrides.
  /// When present, takes precedence over themeId / primaryColor / secondaryColor.
  themeConfig      Json?

  /// Unpublished draft of the theme customization.
  /// The merchant can preview this before publishing to themeConfig.
  draftThemeConfig Json?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  isIndexed      Boolean  @default(true)

  showStoreName    Boolean  @default(true)

  announcementText String?
  description      String?
  email            String?
  whatsappNumber   String?
  instagram        String?
  facebook         String?
  tiktok           String?

  telegramChatId    String?
  telegramLinkToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())

  ip        String?
  userAgent String?

  @@index([storeId, createdAt])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String
  image     String?
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([storeId, slug])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  price          Float
  compareAtPrice Float?
  costPrice      Float?

  image  String   @default("/images/product-placeholder.png")
  images String[] @default([])

  brand String?

  stock             Int  @default(0)
  lowStockThreshold Int?

  sku     String?
  barcode String?

  sizes  String[] @default([])
  colors String[] @default([])
  tags   String[] @default([])

  weight     Float?
  attributes Json?

  wholesaleOptions Json?

  type        ProductType @default(SIMPLE)
  bundleItems Json?

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  hasVariants Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems           CartItem[]
  orderItems          OrderItem[]
  suggestedOrderItems SuggestedOrderItem[]
  reviews             ProductReview[]
  returnItems         PosReturnItem[]
  stockMovements      StockMovement[]

  variants         ProductVariant[]
  suppliers        ProductSupplier[]
  branchInventory  BranchInventory[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems    StockTransferItem[]
  adjustmentItems  InventoryAdjustmentItem[]

  @@index([storeId, isActive])
  @@index([storeId, isActive, createdAt])
  @@index([storeId, barcode])
  @@index([storeId, sku])
  @@index([categoryId])
  @@index([storeId, categoryId, isActive])
}

model Banner {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  title    String
  image    String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([storeId, isActive])
}

model CartItem {
  id             String @id @default(uuid())
  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity         Int   @default(1)
  selectedFeatures Json?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([guestSessionId, storeId])
  @@index([storeId])
  @@index([productId])
  @@index([userId])
}

model Coupon {
  id          String     @id @default(uuid())
  code        String
  type        CouponType
  value       Float
  isActive    Boolean    @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  minSubtotal Float?
  maxDiscount Float?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  appliedCoupons AppliedCoupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId, code, isActive])
}

model AppliedCoupon {
  id             String @id @default(uuid())
  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guestSessionId, storeId])
  @@index([couponId])
}

model ShippingMethod {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  price         Int
  description   String?
  estimatedDays Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  orders Order[]

  @@index([storeId, isActive])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  VIP
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  REWARD
}

enum CustomerTimelineEventType {
  ORDER_PLACED
  ORDER_RETURNED
  ORDER_CANCELED
  POINTS_EARNED
  POINTS_REDEEMED
  POINTS_ADJUSTED
  WALLET_CREDITED
  WALLET_DEBITED
  TAG_ADDED
  TAG_REMOVED
  NOTE_ADDED
  PROFILE_UPDATED
  REFERRAL_MADE
}

enum SegmentType {
  MANUAL
  AUTOMATIC
}

model Customer {
  id            String         @id @default(uuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phone         String
  name          String?
  email         String?
  address       String?
  birthday      DateTime?
  notes         String?
  points        Int            @default(0)
  walletBalance Int            @default(0)
  referralCode  String?        @unique
  referredById  String?
  status        CustomerStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  appliedLoyalty      AppliedLoyaltyPoints[]
  walletTransactions  CustomerWalletTransaction[]
  staffNotes          CustomerNote[]
  timeline            CustomerTimeline[]
  tags                CustomerTagAssignment[]
  segmentMemberships  CustomerSegmentMembership[]
  referredBy          Customer?                   @relation("CustomerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           Customer[]                  @relation("CustomerReferrals")

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  content    String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
}

model CustomerWalletTransaction {
  id            String                @id @default(uuid())
  customerId    String
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type          WalletTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String?
  reference     String?
  createdAt     DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
}

model CustomerTimeline {
  id          String                    @id @default(uuid())
  customerId  String
  customer    Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  eventType   CustomerTimelineEventType
  title       String
  description String?
  metadata    Json?
  referenceId String?
  createdAt   DateTime                  @default(now())

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
}

model CustomerTag {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())

  assignments CustomerTagAssignment[]

  @@unique([storeId, name])
  @@index([storeId])
}

model CustomerTagAssignment {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@unique([customerId, tagId])
  @@index([tagId])
}

model CustomerSegment {
  id          String      @id @default(uuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        SegmentType @default(MANUAL)
  color       String?
  rules       Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  memberships CustomerSegmentMembership[]

  @@unique([storeId, name])
  @@index([storeId])
}

model CustomerSegmentMembership {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  addedAt    DateTime        @default(now())

  @@unique([customerId, segmentId])
  @@index([segmentId])
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  customerId  String
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String?
  type        LoyaltyTransactionType
  points      Int
  description String?
  createdAt   DateTime               @default(now())

  @@index([customerId, createdAt])
}

model AppliedLoyaltyPoints {
  id             String   @id @default(uuid())
  guestSessionId String
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points         Int
  createdAt      DateTime @default(now())

  @@unique([guestSessionId, storeId])
  @@index([customerId])
}

model Order {
  id String @id @default(uuid())

  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  source        OrderSource @default(ONLINE)
  status        OrderStatus @default(PENDING)
  paymentMethod String

  subtotal Int
  shipping Int @default(0)
  discount Int @default(0)
  total    Int
  costTotal   Int?
  profitTotal Int?

  couponCode String?
  notes      String?

  fullName String
  phone    String
  address  String

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  pointsEarned   Int?
  pointsRedeemed Int?

  paymentProvider  String?
  paymentStatus    String?
  paymentReference String?
  paidAt           DateTime?

  posShiftId  String?
  posShift    PosShift? @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  cashierId   String?
  cashierUser User?     @relation("CashierOrders", fields: [cashierId], references: [id], onDelete: SetNull)

  trackingNumber   String?
  shippingProvider String?
  shippingLabelUrl String?

  createdAt DateTime @default(now())

  items          OrderItem[]
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  suggestedOrder SuggestedOrder?
  splitPayments  PosSplitPayment[]
  posReturns     PosReturn[]      @relation("OriginalOrderReturns")
  shipments      Shipment[]

  @@index([storeId, source, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([guestSessionId, storeId])
  @@index([posShiftId])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  price            Int
  costPrice        Int?
  profitAmount     Int?
  discountAmount   Int?
  quantity         Int
  selectedFeatures Json?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum KashierMode {
  TEST
  LIVE
}

model StorePaymentSettings {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  enabledPaymentMethods String[] @default([])
  manualPaymentDetails  Json?

  cashOnDeliveryEnabled Boolean @default(true)

  vodafoneCashEnabled Boolean @default(false)
  vodafoneCashNumber  String?

  instapayEnabled Boolean @default(false)
  instapayAddress String?

  bankTransferEnabled Boolean @default(false)
  bankTransferDetails String?

  kashierEnabled         Boolean     @default(false)
  kashierMode            KashierMode @default(TEST)
  kashierMerchantId      String?
  kashierApiKeyEncrypted String?
  kashierApiKeyHint      String?
  kashierAllowedMethods  String[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kashierEnabled])
}

model BalanceTransaction {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  type          BalanceTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int

  note      String?
  reference String?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ProductType {
  SIMPLE
  BUNDLE
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  MANUAL
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  CANCELED
}

enum BalanceTransactionType {
  TOPUP
  SUBSCRIPTION_CHARGE
  BONUS
  MANUAL_ADJUSTMENT
  REFUND
  REFERRAL_REWARD
}

enum TopupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopupMethod {
  VODAFONE_CASH
  INSTAPAY
  BANK_TRANSFER
  KASHIER
}

model TopupRequest {
  id           String             @id @default(uuid())
  amount       Int
  method       TopupMethod
  status       TopupRequestStatus @default(PENDING)
  note         String?
  transferRef  String?
  receiptImage String?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status, createdAt])
  @@index([status, createdAt])
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model ServiceRequest {
  id String @id @default(uuid())

  serviceId    String
  serviceTitle String

  fullName  String
  phone     String
  whatsapp  String?
  storeLink String?
  notes     String?

  status ServiceRequestStatus @default(PENDING)

  adminNote   String?
  handledAt   DateTime?
  handledById String?

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([serviceId, status])
}

enum SupportRequestStatus {
  PENDING
  OPENED
  RESOLVED
  CLOSED
}

model SupportRequest {
  id String @id @default(uuid())

  title   String
  message String

  status SupportRequestStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  href      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([storeId, readAt, createdAt])
  @@index([type, createdAt])
}

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS_CHANGED
  TOPUP_REQUEST_CREATED
  TOPUP_APPROVED
  TOPUP_REJECTED
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_UPDATED
  SUPPORT_REQUEST_CREATED
  POWERED_BY_APPROVED
  POWERED_BY_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  STORE_ACTIVATED
  STORE_PAST_DUE
  ABANDONED_CART
  SYSTEM
  IG_ORDER_SUGGESTED
  IG_CONNECTION_EXPIRED
  LOW_STOCK
  OUT_OF_STOCK
  PURCHASE_ORDER_RECEIVED
  STORE_INVITATION
  MEMBER_JOINED
  MEMBER_REMOVED
  OWNERSHIP_TRANSFERRED
}

// ─────────────────────────────────────────────────────────────
// Instagram AI Orders
// ─────────────────────────────────────────────────────────────

enum IgConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum IgConversationStatus {
  UNPROCESSED
  PROCESSING
  NO_ORDER
  SUGGESTED
  IGNORED
}

enum SuggestedOrderStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum IgJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())

  posts BlogPost[]
}

model BlogPost {
  id String @id @default(uuid())

  title String
  slug  String @unique

  excerpt String?
  content String  @db.Text

  coverImage String?
  gallery    String[] @default([])

  authorName String @default("Casho Team")

  status BlogStatus @default(DRAFT)

  featured Boolean @default(false)

  readTime Int? // بالدقائق

  views Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  tags BlogPostTag[]

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  blogViews      BlogView[]

  @@index([status, publishedAt])
  @@index([featured])
}

model BlogTag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogView {
  id String @id @default(uuid())

  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomDomainStatus {
  PENDING
  ACTIVE
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Instagram AI Orders — Models
// ─────────────────────────────────────────────────────────────

model InstagramConnection {
  id              String             @id @default(uuid())
  storeId         String             @unique
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  igUserId        String
  igUsername      String
  igPageId        String?
  igPageName      String?

  // AES-256-GCM encrypted long-lived token (via lib/secrets.ts encryptSecret)
  accessTokenEnc  String

  tokenExpiresAt  DateTime?
  status          IgConnectionStatus @default(ACTIVE)
  webhookVerified Boolean            @default(false)
  lastSyncAt      DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  conversations   InstagramConversation[]

  @@index([storeId])
  @@index([status])
}

model InstagramConversation {
  id               String               @id @default(uuid())
  connectionId     String
  connection       InstagramConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  storeId          String
  igConversationId String               @unique

  customerIgId       String
  customerIgName     String?
  customerIgUsername String?

  lastMessageAt    DateTime
  messageCount     Int                  @default(0)
  status           IgConversationStatus @default(UNPROCESSED)

  lastAnalyzedAt   DateTime?
  analysisVersion  Int                  @default(0)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  messages         InstagramMessage[]
  suggestedOrders  SuggestedOrder[]
  jobs             IgProcessingJob[]

  @@index([storeId, status])
  @@index([connectionId, lastMessageAt])
}

model InstagramMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   InstagramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  igMessageId    String                @unique
  fromIgId       String
  isFromBusiness Boolean
  messageType    String                @default("text")
  content        String?
  attachmentUrl  String?
  sentAt         DateTime

  createdAt      DateTime              @default(now())

  @@index([conversationId, sentAt])
}

model SuggestedOrder {
  id               String               @id @default(uuid())
  storeId          String
  store            Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     InstagramConversation @relation(fields: [conversationId], references: [id])

  customerName     String?
  customerPhone    String?
  customerAddress  String?
  aiNotes          String?
  confidence       Float

  rawAiResponse    Json

  // Immutable snapshot of conversation messages at analysis time (for debugging/auditing)
  conversationSnapshot Json?

  // Merchant feedback — captured when merchant edits AI fields or rejects with reason
  merchantEdited   Boolean  @default(false)
  merchantFeedback Json?

  status           SuggestedOrderStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?

  orderId          String?              @unique
  order            Order?               @relation(fields: [orderId], references: [id])

  expiresAt        DateTime

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items            SuggestedOrderItem[]

  @@index([storeId, status, createdAt])
  @@index([conversationId])
  @@index([expiresAt, status])
}

model SuggestedOrderItem {
  id               String         @id @default(uuid())
  suggestedOrderId String
  suggestedOrder   SuggestedOrder @relation(fields: [suggestedOrderId], references: [id], onDelete: Cascade)

  aiProductName    String
  aiVariant        String?
  aiQuantity       Int            @default(1)

  matchedProductId String?
  matchedProduct   Product?       @relation(fields: [matchedProductId], references: [id])
  matchedVariant   String?
  unitPrice        Int?

  createdAt        DateTime       @default(now())
}

model IgProcessingJob {
  id             String                @id @default(uuid())
  conversationId String
  conversation   InstagramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  status         IgJobStatus           @default(QUEUED)
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(3)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  errorMessage   String?

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, nextRetryAt])
  @@index([conversationId])
}

// Webhook replay protection — stores processed igMessageIds so Meta retries are idempotent
model IgProcessedWebhookEvent {
  id          String   @id @default(uuid())
  eventKey    String   @unique // igMessageId (or composite key for non-message events)
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model ProductReview {
  id               String   @id @default(uuid())

  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerName     String
  customerAvatar   String?
  rating           Int
  title            String?
  content          String   @db.Text
  verifiedPurchase Boolean  @default(false)
  reviewDate       DateTime @default(now())

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId, rating])
  @@index([storeId, createdAt])
  @@index([productId, reviewDate])
}

// ─────────────────────────────────────────────────────────────
// Multi-tenant store membership & invitations
// ─────────────────────────────────────────────────────────────

model StoreMember {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role     StoreRole
  joinedAt DateTime  @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
}

model StoreInvitation {
  id              String    @id @default(uuid())
  email           String
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role            StoreRole
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  invitedByUserId String
  invitedBy       User      @relation("SentInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([storeId])
  @@index([email])
  @@index([expiresAt])
}

// Per-store AI usage tracking for daily rate limiting
model IgAiUsageLog {
  id       String @id @default(uuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD
  jobCount Int    @default(0)

  @@unique([storeId, date])
  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────
// POS System — Enums
// ─────────────────────────────────────────────────────────────

enum OrderSource {
  ONLINE
  POS
  INSTAGRAM
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosShiftEntryType {
  CASH_IN
  CASH_OUT
  OPENING_FLOAT
  CLOSING_COUNT
}

enum PosReturnStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum PosReturnType {
  FULL_RETURN
  PARTIAL_RETURN
  EXCHANGE
}

enum StockMovementType {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
  DAMAGE
  INITIAL
  TRANSFER_IN
  TRANSFER_OUT
  COUNT
  WRITE_OFF
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum AdjustmentReason {
  DAMAGE
  THEFT
  EXPIRY
  COUNT_CORRECTION
  LOSS
  FOUND
  OTHER
}

// ─────────────────────────────────────────────────────────────
// POS System — Models
// ─────────────────────────────────────────────────────────────

model PosShift {
  id               String         @id @default(uuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId        String
  cashier          User           @relation("CashierShifts", fields: [cashierId], references: [id])
  status           PosShiftStatus @default(OPEN)
  openingBalance   Int            @default(0)
  closingBalance   Int?
  expectedCash     Int?
  cashDifference   Int?
  totalSales       Int            @default(0)
  totalReturns     Int            @default(0)
  totalDiscount    Int            @default(0)
  transactionCount Int            @default(0)
  returnCount      Int            @default(0)
  notes            String?
  openedAt         DateTime       @default(now())
  closedAt         DateTime?
  entries          PosShiftEntry[]
  orders           Order[]

  @@index([storeId, status])
  @@index([cashierId, openedAt])
  @@index([storeId, openedAt])
}

model PosShiftEntry {
  id        String            @id @default(uuid())
  shiftId   String
  shift     PosShift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      PosShiftEntryType
  amount    Int
  note      String?
  createdAt DateTime          @default(now())

  @@index([shiftId, createdAt])
}

model PosHeldOrder {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashierId String
  cashier   User     @relation("CashierHeldOrders", fields: [cashierId], references: [id])
  label     String?
  note      String?
  cartData  Json
  itemCount Int      @default(0)
  total     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, cashierId])
  @@index([storeId, createdAt])
}

model PosSplitPayment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod String
  amount        Int
  reference     String?
  createdAt     DateTime @default(now())

  @@index([orderId])
}

model PosReturn {
  id              String          @id @default(uuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  originalOrderId String
  originalOrder   Order           @relation("OriginalOrderReturns", fields: [originalOrderId], references: [id])
  cashierId       String?
  cashier         User?           @relation("CashierReturns", fields: [cashierId], references: [id])
  type            PosReturnType
  status          PosReturnStatus @default(PENDING)
  reason          String?
  refundAmount    Int
  refundMethod    String?
  exchangeOrderId String?         @unique
  notes           String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  items           PosReturnItem[]

  @@index([storeId, createdAt])
  @@index([originalOrderId])
}

model PosReturnItem {
  id        String    @id @default(uuid())
  returnId  String
  return    PosReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  reason    String?

  @@index([returnId])
}

model StockMovement {
  id          String            @id @default(uuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type        StockMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reference   String?
  note        String?
  userId      String?
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, type, createdAt])
  @@index([variantId, createdAt])
  @@index([branchId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Inventory Management System
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory      BranchInventory[]
  movements      StockMovement[]
  transfersFrom  StockTransfer[]   @relation("TransferFrom")
  transfersTo    StockTransfer[]   @relation("TransferTo")
  purchaseOrders PurchaseOrder[]
  adjustments    InventoryAdjustment[]

  @@index([storeId])
  @@index([storeId, isDefault])
}

model ProductVariant {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name       String
  sku        String?
  barcode    String?
  attributes Json
  price      Float?
  costPrice  Float?
  stock      Int     @default(0)
  lowStockThreshold Int?
  imageUrl   String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchInventory    BranchInventory[]
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  adjustmentItems    InventoryAdjustmentItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
  @@index([storeId, barcode])
}

model BranchInventory {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity         Int @default(0)
  reservedQuantity Int @default(0)
  incomingQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId, variantId])
  @@index([storeId])
  @@index([branchId])
  @@index([productId])
}

model Supplier {
  id        String  @id @default(uuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  notes     String?
  balance   Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@index([storeId])
}

model ProductSupplier {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  costPrice  Float?

  @@unique([productId, supplierId])
  @@index([storeId])
  @@index([supplierId])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  storeId     String
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branchId    String?
  branch      Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  totalAmount Int                 @default(0)
  expectedDate DateTime?
  receivedAt  DateTime?
  createdById String
  createdBy   User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([storeId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  quantity        Int
  receivedQuantity Int          @default(0)
  unitCost        Int
  totalCost       Int

  @@index([purchaseOrderId])
  @@index([productId])
}

model StockTransfer {
  id           String         @id @default(uuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fromBranchId String
  fromBranch   Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  status       TransferStatus @default(PENDING)
  reference    String?
  notes        String?
  createdById  String
  createdBy    User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  shippedAt    DateTime?
  receivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items StockTransferItem[]

  @@index([storeId])
  @@index([storeId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model StockTransferItem {
  id                String        @id @default(uuid())
  transferId        String
  transfer          StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  requestedQuantity Int
  shippedQuantity   Int           @default(0)
  receivedQuantity  Int           @default(0)

  @@index([transferId])
  @@index([productId])
}

model InventoryAdjustment {
  id        String           @id @default(uuid())
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  reason    AdjustmentReason
  notes     String?
  reference String?
  createdAt DateTime         @default(now())

  items InventoryAdjustmentItem[]

  @@index([storeId])
  @@index([storeId, createdAt])
}

model InventoryAdjustmentItem {
  id           String              @id @default(uuid())
  adjustmentId String
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product             @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant?     @relation(fields: [variantId], references: [id])
  quantityBefore Int
  quantityAfter  Int
  quantityChange Int

  @@index([adjustmentId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Public API — API Keys
// ─────────────────────────────────────────────────────────────

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model ApiKey {
  id          String       @id @default(uuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String       @unique
  keyHint     String
  status      ApiKeyStatus @default(ACTIVE)
  scopes      String[]     @default([])
  ipWhitelist String[]     @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  requestLogs ApiRequestLog[]

  @@index([storeId])
  @@index([keyHash])
  @@index([storeId, status])
}

model ApiRequestLog {
  id         String   @id @default(uuid())
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  method     String
  path       String
  statusCode Int
  durationMs Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([storeId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Webhooks
// ─────────────────────────────────────────────────────────────

enum WebhookStatus {
  ACTIVE
  DISABLED
}

model WebhookEndpoint {
  id        String        @id @default(uuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  status    WebhookStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deliveries WebhookDelivery[]

  @@index([storeId])
  @@index([storeId, status])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD_LETTER
}

model WebhookDelivery {
  id               String                @id @default(uuid())
  endpointId       String
  endpoint         WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  storeId          String
  event            String
  payload          Json
  status           WebhookDeliveryStatus @default(PENDING)
  attempts         Int                   @default(0)
  maxAttempts      Int                   @default(5)
  nextRetryAt      DateTime?
  lastAttemptAt    DateTime?
  lastResponseCode Int?
  lastResponseBody String?
  error            String?
  deliveredAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([endpointId, status])
  @@index([status, nextRetryAt])
  @@index([storeId, event])
}

// ─────────────────────────────────────────────────────────────
// Shipping Integrations (Logistics Engine)
// ─────────────────────────────────────────────────────────────

enum ShippingProvider {
  BOSTA
  ARAMEX
}

model ShippingIntegration {
  id          String           @id @default(uuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider    ShippingProvider
  isActive    Boolean          @default(true)
  /// AES-256-GCM encrypted JSON string of provider-specific credentials (via lib/secrets.ts)
  credentials String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
  @@index([storeId, isActive])
}

// ─────────────────────────────────────────────────────────────
// Shipping
// ─────────────────────────────────────────────────────────────

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELED
}

model Shipment {
  id                 String         @id @default(uuid())
  storeId            String
  store              Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId            String?
  order              Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider           String
  providerShipmentId String?
  trackingNumber     String?
  status             ShipmentStatus @default(CREATED)
  courierName        String?
  cost               Int?
  estimatedDelivery  DateTime?
  providerPayload    Json?
  canceledAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([storeId])
  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}
