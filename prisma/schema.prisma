generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  phone_number        String?              @unique
  password            String?
  googleId            String?              @unique
  name                String?
  country             String?
  businessType        String?
  stores              Store[]
  createdAt           DateTime             @default(now())
  cartItems           CartItem[]
  orders              Order[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  supportRequests     SupportRequest[]
  notifications       Notification[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Store {
  id   String @id @default(uuid())
  name String
  slug String @unique

  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionEndsAt DateTime?
  gracePeriodEndsAt  DateTime?
  autoRenew          Boolean            @default(true)

  balance        Int      @default(0)
  monthlyPrice   Int      @default(29900)
  planSelected   Boolean  @default(false)
  paymentMethods String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  products   Product[]
  cartItems  CartItem[]
  orders     Order[]
  categories Category[]
  banners    Banner[]
  settings   StoreSettings?
  visits     Visit[]

  balanceTransactions BalanceTransaction[]
  topupRequests       TopupRequest[]
  serviceRequests     ServiceRequest[]

  coupons        Coupon[]
  appliedCoupons AppliedCoupon[]

  showPoweredByCasho      Boolean @default(true)
  poweredByRemovalEnabled Boolean @default(false)

  createdAt            DateTime              @default(now())
  supportRequests      SupportRequest[]
  storePaymentSettings StorePaymentSettings?
  notifications        Notification[]

  customDomain           String?             @unique
  customDomainStatus     CustomDomainStatus  @default(PENDING)
  customDomainConnectedAt DateTime?

  instagramConnection  InstagramConnection?
  suggestedOrders      SuggestedOrder[]
  igAiUsageLogs        IgAiUsageLog[]
  reviews              ProductReview[]

  @@index([subscriptionStatus])
  @@index([subscriptionEndsAt])
  @@index([gracePeriodEndsAt])
}

model StoreSettings {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id])

  themeId        String  @default("default")
  fontId         String  @default("cairo")
  storeLanguage  String  @default("ar")
  logo           String?
  logoRadius     Int     @default(8)
  coverImage     String?
  primaryColor   String?
  secondaryColor String?
  navbarVariant  String  @default("default")
  shippingPrice  Int     @default(0)

  /// Full merchant theme customization (ThemeCustomization JSON).
  /// Stores presetId + tokenOverrides + layoutOverrides + sectionOverrides.
  /// When present, takes precedence over themeId / primaryColor / secondaryColor.
  themeConfig      Json?

  /// Unpublished draft of the theme customization.
  /// The merchant can preview this before publishing to themeConfig.
  draftThemeConfig Json?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  isIndexed      Boolean  @default(true)

  showStoreName    Boolean  @default(true)

  announcementText String?
  description      String?
  email            String?
  whatsappNumber   String?
  instagram        String?
  facebook         String?
  tiktok           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())

  ip        String?
  userAgent String?

  @@index([storeId, createdAt])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String
  image     String?
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([storeId, slug])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  price          Float
  compareAtPrice Float?

  image  String   @default("/images/product-placeholder.png")
  images String[] @default([])

  brand String?

  stock Int @default(0)

  sizes  String[] @default([])
  colors String[] @default([])
  tags   String[] @default([])

  weight     Float?
  attributes Json?

  wholesaleOptions Json?

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  hasVariants Boolean @default(false)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems           CartItem[]
  orderItems          OrderItem[]
  suggestedOrderItems SuggestedOrderItem[]
  reviews             ProductReview[]
}

model Banner {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  title    String
  image    String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model CartItem {
  id             String @id @default(uuid())
  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity         Int   @default(1)
  selectedFeatures Json?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

model Coupon {
  id          String     @id @default(uuid())
  code        String
  type        CouponType
  value       Float
  isActive    Boolean    @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int        @default(0)
  minSubtotal Float?
  maxDiscount Float?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  appliedCoupons AppliedCoupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId, code, isActive])
}

model AppliedCoupon {
  id             String @id @default(uuid())
  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([guestSessionId, storeId])
  @@index([couponId])
}

model Order {
  id String @id @default(uuid())

  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  status        OrderStatus @default(PENDING)
  paymentMethod String

  subtotal Int
  shipping Int @default(0)
  discount Int @default(0)
  total    Int

  couponCode String?

  fullName String
  phone    String
  address  String

  paymentProvider  String?
  paymentStatus    String?
  paymentReference String?
  paidAt           DateTime?

  createdAt DateTime @default(now())

  items          OrderItem[]
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  suggestedOrder SuggestedOrder?
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  price            Int
  quantity         Int
  selectedFeatures Json?

  createdAt DateTime @default(now())
}

enum KashierMode {
  TEST
  LIVE
}

model StorePaymentSettings {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  enabledPaymentMethods String[] @default([])
  manualPaymentDetails  Json?

  cashOnDeliveryEnabled Boolean @default(true)

  vodafoneCashEnabled Boolean @default(false)
  vodafoneCashNumber  String?

  instapayEnabled Boolean @default(false)
  instapayAddress String?

  bankTransferEnabled Boolean @default(false)
  bankTransferDetails String?

  kashierEnabled         Boolean     @default(false)
  kashierMode            KashierMode @default(TEST)
  kashierMerchantId      String?
  kashierApiKeyEncrypted String?
  kashierApiKeyHint      String?
  kashierAllowedMethods  String[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kashierEnabled])
}

model BalanceTransaction {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  type          BalanceTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int

  note      String?
  reference String?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  CANCELED
}

enum BalanceTransactionType {
  TOPUP
  SUBSCRIPTION_CHARGE
  BONUS
  MANUAL_ADJUSTMENT
  REFUND
}

enum TopupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TopupMethod {
  VODAFONE_CASH
  INSTAPAY
  BANK_TRANSFER
  KASHIER
}

model TopupRequest {
  id           String             @id @default(uuid())
  amount       Int
  method       TopupMethod
  status       TopupRequestStatus @default(PENDING)
  note         String?
  transferRef  String?
  receiptImage String?

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model ServiceRequest {
  id String @id @default(uuid())

  serviceId    String
  serviceTitle String

  fullName  String
  phone     String
  whatsapp  String?
  storeLink String?
  notes     String?

  status ServiceRequestStatus @default(PENDING)

  adminNote   String?
  handledAt   DateTime?
  handledById String?

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([serviceId, status])
}

enum SupportRequestStatus {
  PENDING
  OPENED
  RESOLVED
  CLOSED
}

model SupportRequest {
  id String @id @default(uuid())

  title   String
  message String

  status SupportRequestStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  href      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([storeId, readAt, createdAt])
  @@index([type, createdAt])
}

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS_CHANGED
  TOPUP_REQUEST_CREATED
  TOPUP_APPROVED
  TOPUP_REJECTED
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_UPDATED
  SUPPORT_REQUEST_CREATED
  POWERED_BY_APPROVED
  POWERED_BY_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  STORE_ACTIVATED
  STORE_PAST_DUE
  ABANDONED_CART
  SYSTEM
  IG_ORDER_SUGGESTED
  IG_CONNECTION_EXPIRED
}

// ─────────────────────────────────────────────────────────────
// Instagram AI Orders
// ─────────────────────────────────────────────────────────────

enum IgConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum IgConversationStatus {
  UNPROCESSED
  PROCESSING
  NO_ORDER
  SUGGESTED
  IGNORED
}

enum SuggestedOrderStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum IgJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())

  posts BlogPost[]
}

model BlogPost {
  id String @id @default(uuid())

  title String
  slug  String @unique

  excerpt String?
  content String  @db.Text

  coverImage String?
  gallery    String[] @default([])

  authorName String @default("Casho Team")

  status BlogStatus @default(DRAFT)

  featured Boolean @default(false)

  readTime Int? // بالدقائق

  views Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  tags BlogPostTag[]

  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]
  blogViews      BlogView[]

  @@index([status, publishedAt])
  @@index([featured])
}

model BlogTag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogView {
  id String @id @default(uuid())

  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomDomainStatus {
  PENDING
  ACTIVE
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Instagram AI Orders — Models
// ─────────────────────────────────────────────────────────────

model InstagramConnection {
  id              String             @id @default(uuid())
  storeId         String             @unique
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  igUserId        String
  igUsername      String
  igPageId        String?
  igPageName      String?

  // AES-256-GCM encrypted long-lived token (via lib/secrets.ts encryptSecret)
  accessTokenEnc  String

  tokenExpiresAt  DateTime?
  status          IgConnectionStatus @default(ACTIVE)
  webhookVerified Boolean            @default(false)
  lastSyncAt      DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  conversations   InstagramConversation[]

  @@index([storeId])
  @@index([status])
}

model InstagramConversation {
  id               String               @id @default(uuid())
  connectionId     String
  connection       InstagramConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  storeId          String
  igConversationId String               @unique

  customerIgId       String
  customerIgName     String?
  customerIgUsername String?

  lastMessageAt    DateTime
  messageCount     Int                  @default(0)
  status           IgConversationStatus @default(UNPROCESSED)

  lastAnalyzedAt   DateTime?
  analysisVersion  Int                  @default(0)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  messages         InstagramMessage[]
  suggestedOrders  SuggestedOrder[]
  jobs             IgProcessingJob[]

  @@index([storeId, status])
  @@index([connectionId, lastMessageAt])
}

model InstagramMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   InstagramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  igMessageId    String                @unique
  fromIgId       String
  isFromBusiness Boolean
  messageType    String                @default("text")
  content        String?
  attachmentUrl  String?
  sentAt         DateTime

  createdAt      DateTime              @default(now())

  @@index([conversationId, sentAt])
}

model SuggestedOrder {
  id               String               @id @default(uuid())
  storeId          String
  store            Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     InstagramConversation @relation(fields: [conversationId], references: [id])

  customerName     String?
  customerPhone    String?
  customerAddress  String?
  aiNotes          String?
  confidence       Float

  rawAiResponse    Json

  // Immutable snapshot of conversation messages at analysis time (for debugging/auditing)
  conversationSnapshot Json?

  // Merchant feedback — captured when merchant edits AI fields or rejects with reason
  merchantEdited   Boolean  @default(false)
  merchantFeedback Json?

  status           SuggestedOrderStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?

  orderId          String?              @unique
  order            Order?               @relation(fields: [orderId], references: [id])

  expiresAt        DateTime

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items            SuggestedOrderItem[]

  @@index([storeId, status, createdAt])
  @@index([conversationId])
  @@index([expiresAt, status])
}

model SuggestedOrderItem {
  id               String         @id @default(uuid())
  suggestedOrderId String
  suggestedOrder   SuggestedOrder @relation(fields: [suggestedOrderId], references: [id], onDelete: Cascade)

  aiProductName    String
  aiVariant        String?
  aiQuantity       Int            @default(1)

  matchedProductId String?
  matchedProduct   Product?       @relation(fields: [matchedProductId], references: [id])
  matchedVariant   String?
  unitPrice        Int?

  createdAt        DateTime       @default(now())
}

model IgProcessingJob {
  id             String                @id @default(uuid())
  conversationId String
  conversation   InstagramConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  status         IgJobStatus           @default(QUEUED)
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(3)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  errorMessage   String?

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, nextRetryAt])
  @@index([conversationId])
}

// Webhook replay protection — stores processed igMessageIds so Meta retries are idempotent
model IgProcessedWebhookEvent {
  id          String   @id @default(uuid())
  eventKey    String   @unique // igMessageId (or composite key for non-message events)
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model ProductReview {
  id               String   @id @default(uuid())

  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerName     String
  customerAvatar   String?
  rating           Int
  title            String?
  content          String   @db.Text
  verifiedPurchase Boolean  @default(false)
  reviewDate       DateTime @default(now())

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId, rating])
  @@index([storeId, createdAt])
  @@index([productId, reviewDate])
}

// Per-store AI usage tracking for daily rate limiting
model IgAiUsageLog {
  id       String @id @default(uuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD
  jobCount Int    @default(0)

  @@unique([storeId, date])
  @@index([storeId])
}
