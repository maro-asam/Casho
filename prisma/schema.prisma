// ─────────────────────────────────────────────────────────────
// Shipping Integrations (Logistics Engine)
// ─────────────────────────────────────────────────────────────

model ShippingIntegration {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Carrier key from lib/shipping/carriers.ts (BOSTA, ARAMEX, MYLERZ, …)
  provider    String
  isActive    Boolean  @default(true)
  /// AES-256-GCM encrypted JSON string of provider-specific credentials (via lib/secrets.ts).
  /// Null for carriers connected manually (no API).
  credentials String?
  /// CarrierSettings (lib/shipping/carriers.ts): tracking link template, default weight, pickup governorate…
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
  @@index([storeId, isActive])
}

// ─────────────────────────────────────────────────────────────
// Shipping
// ─────────────────────────────────────────────────────────────

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELED
}

model Shipment {
  id                 String         @id @default(uuid())
  storeId            String
  store              Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId            String?
  order              Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider           String
  providerShipmentId String?
  trackingNumber     String?
  status             ShipmentStatus @default(CREATED)
  courierName        String?
  cost               Int?
  /// Cash the courier collects from the customer (piasters); 0/null = prepaid.
  codAmount          Int?
  /// When the merchant received the collected cash from the carrier.
  codCollectedAt     DateTime?
  labelUrl           String?
  /// Public tracking page, resolved from the carrier's link template at creation.
  trackingUrl        String?
  weightKg           Float?
  notes              String?
  /// ShipmentEvent[] (lib/shipping/shipment-status.ts) — the shipment timeline.
  events             Json?
  lastSyncedAt       DateTime?
  estimatedDelivery  DateTime?
  providerPayload    Json?
  canceledAt         DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, status, createdAt])
  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Subscription Plans & Entitlements
// ─────────────────────────────────────────────────────────────
//
// Store already IS the subscription record (subscriptionStatus,
// subscriptionEndsAt, gracePeriodEndsAt, autoRenew, trialStartDate,
// trialEndDate, balance, monthlyPrice all live on Store already).
// These models add the *plan configuration* layer on top: which
// plan a store is on, what that plan includes, and an audit trail
// of plan/pricing changes. Enforcement logic lives in lib/entitlements.ts.

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum FeatureType {
  BOOLEAN // on/off capability, e.g. custom_domain
  NUMERIC_LIMIT // a count with a limit, e.g. products, discount_codes
  PERCENTAGE // a percentage-based configuration value
  TEXT // free-form configuration value (rare; escape hatch)
  ENUM // one of a fixed set of configuration values
}

model Plan {
  id  String @id @default(uuid())
  key String @unique // stable code: SILVER | GOLD | PLATINUM (extendable)

  slug        String  @unique
  name        String
  description String?

  // Pricing — always integer piasters (1 EGP = 100 piasters), never hardcode
  // these numbers anywhere else in the app. See CONFIGURE_ME / pricingConfigured.
  monthlyPrice         Int
  yearlyPrice          Int
  currency             String @default("EGP")
  originalMonthlyPrice Int? // for showing a struck-through "was" price
  originalYearlyPrice  Int?
  discountPercent      Int? // optional display-only discount badge

  // false until the founder confirms these are the real, final prices
  // (seeded prices are clearly-flagged placeholders — see prisma/seed.ts)
  pricingConfigured Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  planFeatures PlanFeature[]
  stores       Store[]
  auditLogs    PlanAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Feature {
  id  String @id @default(uuid())
  key String @unique // stable machine-readable key, e.g. "discount_codes"

  name        String
  description String?
  type        FeatureType
  unit        String? // e.g. "منتج", "كود خصم" — shown next to numeric limits

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  planFeatures PlanFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model PlanFeature {
  id String @id @default(uuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // limitValue = null && isUnlimited = true  -> unlimited
  // limitValue = null && isUnlimited = false -> not applicable (boolean features)
  // limitValue = N                           -> hard numeric limit
  limitValue  Int?
  isUnlimited Boolean @default(false)

  // escape hatch for feature-specific config that doesn't fit limitValue,
  // e.g. { "maxFileSizeMb": 10 } — deliberately loose, see lib/entitlements.ts
  configuration Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureId])
  @@index([featureId])
}

model PlanAuditLog {
  id String @id @default(uuid())

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  // e.g. "plan_created", "plan_updated", "plan_feature_updated",
  // "subscription_upgraded", "subscription_downgraded", "subscription_canceled"
  action String
  before Json?
  after  Json?
  note   String?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([planId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Store migration imports (Shopify today; WooCommerce/Magento later)
// ─────────────────────────────────────────────────────────────
//
// Provider-agnostic. Engine: lib/integrations/import, provider code:
// lib/integrations/<provider>. See docs/integrations/shopify-import.md.

enum ImportProvider {
  SHOPIFY
}

enum ImportConnectionStatus {
  ACTIVE
  /// Token refresh failed / app uninstalled — the merchant must reconnect.
  NEEDS_RECONNECT
  DISCONNECTED
}

enum ImportJobKind {
  FULL
  /// Re-imports only the failed items of `retryOfJobId`.
  RETRY
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  /// Stopped after repeated failures or a lost connection; can be resumed.
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  CANCELED
}

/// Kasho-side record types an external record can map to. Listed in import
/// dependency order (variants are imported together with their product).
enum ImportEntityType {
  COLLECTION
  PRODUCT
  VARIANT
  CUSTOMER
  ORDER
}

/// OAuth connection of a Kasho store to an external shop.
/// Tokens are AES-256-GCM encrypted (lib/secrets.ts) and never leave the server.
model ImportConnection {
  id       String         @id @default(uuid())
  storeId  String
  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider ImportProvider

  /// Stable id of the external shop (e.g. "acme.myshopify.com"). Part of every
  /// ImportRecordMap key, so reconnecting a different shop never collides.
  externalShopId String
  shopName       String
  shopDomain     String
  currencyCode   String?

  accessTokenEnc        String?
  accessTokenExpiresAt  DateTime?
  refreshTokenEnc       String?
  refreshTokenExpiresAt DateTime?
  scopes                String[]               @default([])
  status                ImportConnectionStatus @default(ACTIVE)

  connectedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs ImportJob[]

  @@unique([storeId, provider])
  @@index([provider, externalShopId])
}

model ImportJob {
  id             String           @id @default(uuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     ImportConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider       ImportProvider
  /// Copied from the connection at start — the shop this job reads from.
  externalShopId String

  kind         ImportJobKind      @default(FULL)
  retryOfJobId String?
  status       ImportJobStatus    @default(QUEUED)
  /// Selected entities, in dependency order.
  entities     ImportEntityType[]

  /// Checkpoint: entity being imported + provider pagination cursor.
  currentEntity ImportEntityType?
  cursor        String?
  /// Per-entity counters (ImportProgress in lib/integrations/import/types.ts).
  progress      Json

  attempts    Int       @default(0)
  nextRunAt   DateTime  @default(now())
  lockedUntil DateTime?
  lockToken   String?
  /// Merchant-safe reason for PAUSED (never contains tokens or customer data).
  lastError   String?

  startedByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  errors ImportItemError[]

  @@index([status, nextRunAt])
  @@index([storeId, createdAt])
}

/// Idempotency key: one row per external record ever imported into a store.
/// The unique constraint is what stops re-runs/refreshes from duplicating data.
model ImportRecordMap {
  id             String           @id @default(uuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider       ImportProvider
  externalShopId String
  entityType     ImportEntityType
  externalId     String
  /// Id of the Kasho row (Category / Product / ProductVariant / Customer / Order).
  localId        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, provider, externalShopId, entityType, externalId])
  @@index([storeId, entityType, localId])
}

/// A record that failed to import. Holds ids and a safe reason only — no payload.
model ImportItemError {
  id         String           @id @default(uuid())
  jobId      String
  job        ImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  storeId    String
  entityType ImportEntityType
  externalId String
  /// Human label (product title, order name) to help the merchant find it.
  label      String?
  message    String
  attempts   Int              @default(1)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([jobId, entityType, externalId])
  @@index([jobId, resolvedAt])
}

// ─────────────────────────────────────────────────────────────
// Sales team — referral attribution, tiered commissions, payouts
// ─────────────────────────────────────────────────────────────
//
// Engine: lib/sales. The qualifying "payment" is a SUBSCRIPTION_CHARGE
// BalanceTransaction (subscriptions are paid from the store balance, which is
// only funded by verified Kashier callbacks or admin-approved top-ups).
// Commission rows are immutable snapshots; corrections are adjustments.
// Money is integer piasters. See docs/sales/commissions.md.

enum SalesRepStatus {
  ACTIVE
  DISABLED
}

enum SalesAttributionSource {
  SIGNUP_LINK // registered through the rep's referral link
  ADMIN // assigned by an admin (dispute resolution)
}

enum SalesCommissionKind {
  ACQUISITION // the customer's first-ever subscription charge — tiered rate
  RENEWAL // any later subscription charge inside the 6-month window
}

enum SalesCommissionStatus {
  PENDING
  APPROVED // payable
  ON_HOLD
  REJECTED
  REVERSED
  PAID
}

model SalesRep {
  id     String         @id @default(uuid())
  userId String         @unique
  user   User           @relation("SalesRepUser", fields: [userId], references: [id])
  status SalesRepStatus @default(ACTIVE)
  notes  String?

  createdById String?
  disabledAt  DateTime?

  attributions SalesAttribution[]
  commissions  SalesCommission[]
  payouts      SalesPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SalesAttribution {
  id             String @id @default(uuid())
  customerUserId String @unique
  customer       User   @relation("SalesAttributionCustomer", fields: [customerUserId], references: [id])

  salesRepId         String
  salesRep           SalesRep               @relation(fields: [salesRepId], references: [id])
  originalSalesRepId String
  source             SalesAttributionSource
  referralCode       String?

  signedUpAt DateTime

  // Set from the customer's first-ever SUBSCRIPTION_CHARGE. The cohort month
  // (Africa/Cairo) drives both the "currently eligible" count and the renewal
  // window: eligible while now < eligibleUntil (1st of cohort month + N).
  acquiredAt      DateTime?
  acquisitionTxId String?   @unique
  cohortMonth     String? // "YYYY-MM"
  eligibleUntil   DateTime?

  changes     SalesAttributionChange[]
  commissions SalesCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesRepId, acquiredAt])
  @@index([salesRepId, eligibleUntil])
}

model SalesAttributionChange {
  id             String           @id @default(uuid())
  attributionId  String
  attribution    SalesAttribution @relation(fields: [attributionId], references: [id])
  fromSalesRepId String?
  toSalesRepId   String
  actorUserId    String
  reason         String
  createdAt      DateTime         @default(now())

  @@index([attributionId, createdAt])
}

/// Append-only: the newest row (by effectiveFrom) is the active rule set.
model SalesCommissionRule {
  id                 String   @id @default(uuid())
  starterRateBps     Int
  growthRateBps      Int
  proRateBps         Int
  starterMaxPosition Int
  growthMaxPosition  Int
  renewalRateBps     Int
  eligibilityMonths  Int
  effectiveFrom      DateTime @default(now())
  createdById        String?
  note               String?
  createdAt          DateTime @default(now())

  commissions SalesCommission[]

  @@index([effectiveFrom])
}

model SalesCommission {
  id            String           @id @default(uuid())
  salesRepId    String
  salesRep      SalesRep         @relation(fields: [salesRepId], references: [id])
  attributionId String
  attribution   SalesAttribution @relation(fields: [attributionId], references: [id])

  customerUserId       String
  storeId              String
  balanceTransactionId String // the qualifying SUBSCRIPTION_CHARGE

  kind   SalesCommissionKind
  status SalesCommissionStatus

  // Snapshot at the moment it was earned — never recalculated.
  basisAmount      Int // piasters charged
  rateBps          Int // 1700 = 17%
  amount           Int // piasters, half-up rounded
  currency         String              @default("EGP")
  tier             String? // STARTER | GROWTH | PRO (acquisition only)
  customerPosition Int? // position in the rep's eligible sequence (acquisition only)
  ruleId           String
  rule             SalesCommissionRule @relation(fields: [ruleId], references: [id])
  cohortMonth      String
  eligibleUntil    DateTime
  paymentAt        DateTime
  statusReason     String?

  payoutId String?
  payout   SalesPayout? @relation(fields: [payoutId], references: [id])

  adjustments SalesCommissionAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([balanceTransactionId, kind])
  @@index([salesRepId, status, createdAt])
  @@index([customerUserId, paymentAt])
  @@index([status, createdAt])
  @@index([payoutId])
}

model SalesCommissionAdjustment {
  id           String          @id @default(uuid())
  commissionId String
  commission   SalesCommission @relation(fields: [commissionId], references: [id])
  salesRepId   String

  amount               Int // signed piasters
  currency             String  @default("EGP")
  source               String // REFUND_CREDIT | ADMIN
  balanceTransactionId String? @unique // the REFUND credit, for REFUND_CREDIT
  reason               String
  actorUserId          String?

  payoutId String?
  payout   SalesPayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())

  @@index([salesRepId, createdAt])
  @@index([commissionId])
  @@index([payoutId])
}

/// A payout that already happened outside Casho (bank / wallet transfer),
/// recorded by an admin. Settles every payable item of the rep at that time.
model SalesPayout {
  id           String   @id @default(uuid())
  salesRepId   String
  salesRep     SalesRep @relation(fields: [salesRepId], references: [id])
  amount       Int
  currency     String   @default("EGP")
  paidAt       DateTime
  method       String
  reference    String?
  note         String?
  recordedById String

  commissions SalesCommission[]
  adjustments SalesCommissionAdjustment[]

  createdAt DateTime @default(now())

  @@index([salesRepId, paidAt])
}

model SalesAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  salesRepId  String?
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([salesRepId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Casho Sharks — selective support program for Casho merchants
// (lib/sharks). Applications are reviewed by admins; accepted ones can get a
// support plan (Benefits / Growth only) and, separately, a public story that
// needs recorded consent + admin approval before it is published.
// Nothing here moves money: there is no funding, grant or payout path.
// Actor ids are plain strings (like SalesAuditLog) so admin accounts can be
// removed without breaking the history.
// ─────────────────────────────────────────────────────────────

enum SharksApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUESTED
  INTERVIEW
  ACCEPTED
  WAITLISTED
  REJECTED
}

/// What an applicant can ask for. Investment interest is a separate boolean on
/// the application — informational only, never a request for funding.
enum SharksTrack {
  BENEFITS
  GROWTH
}

enum SharksEventKind {
  SUBMITTED
  STATUS_CHANGE
  INFO_REQUEST
  APPLICANT_REPLY
  NOTE
  EVALUATION
  INTERVIEW
  PLAN
  PROGRESS
  STORY
}

enum SharksPlanStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELED
}

enum SharksTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum SharksStoryStatus {
  PROPOSED
  AWAITING_CONSENT
  CONSENT_RECORDED
  IN_PRODUCTION
  IN_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Singleton (id = "default"). Missing row = the defaults below.
model SharksProgram {
  id                String   @id @default("default")
  applicationsOpen  Boolean  @default(true)
  benefitsAvailable Boolean  @default(true)
  growthAvailable   Boolean  @default(true)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

model SharksApplication {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// The signed-in owner who applied.
  userId  String

  status        SharksApplicationStatus @default(SUBMITTED)
  /// Client-generated per form session — a double submit can't create two rows.
  submissionKey String                  @unique

  // Step 1 — business
  businessName   String
  storeUrl       String
  industry       String
  description    String
  operatingSince String

  // Step 2 — situation
  offering  String
  customers String
  challenge String
  traction  String
  potential String

  // Step 3 — support
  requestedTracks    SharksTrack[]
  /// "Would like to hear about investment pathways in future" — no funding request exists.
  investmentInterest Boolean       @default(false)
  supportGoal        String

  // Step 4 — materials + consent
  links            String[]
  extraInfo        String?
  termsAcceptedAt  DateTime
  /// Optional willingness to be featured later. NOT publication consent — that
  /// is recorded per story (SharksStory.consent*).
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?

  /// Latest question from the team while status = INFO_REQUESTED (shown to the applicant).
  infoRequest String?

  interviewAt       DateTime?
  interviewLocation String?

  decidedAt   DateTime?
  decidedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      SharksApplicationEvent[]
  evaluations SharksEvaluation[]
  plan        SharksSupportPlan?
  story       SharksStory?

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@index([userId])
}

/// Append-only history: status changes, notes, info requests, replies…
/// `visibleToApplicant` rows are the only ones the merchant ever sees.
model SharksApplicationEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   SharksApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind               SharksEventKind
  fromStatus         SharksApplicationStatus?
  toStatus           SharksApplicationStatus?
  message            String?
  visibleToApplicant Boolean                  @default(false)
  actorId            String?
  createdAt          DateTime                 @default(now())

  @@index([applicationId, createdAt])
}

/// One scorecard per reviewer (out of 100). An aid, never an automatic decision.
model SharksEvaluation {
  id            String            @id @default(uuid())
  applicationId String
  application   SharksApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId    String

  product    Int
  demand     Int
  founder    Int
  growth     Int
  experience Int
  clarity    Int
  total      Int
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, reviewerId])
}

/// What Casho has actually agreed to deliver. Track is Benefits or Growth —
/// the enum has no investment value, so a plan can't express funding.
model SharksSupportPlan {
  id            String            @id @default(uuid())
  applicationId String            @unique
  application   SharksApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  track       SharksTrack
  /// Keys from lib/sharks/catalog.ts (BENEFIT_KEYS).
  benefits    String[]
  scope       String
  limitations String?
  startsOn    DateTime?
  endsOn      DateTime?
  ownerId     String?
  status      SharksPlanStatus @default(PLANNED)
  completedAt DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks SharksPlanTask[]
}

model SharksPlanTask {
  id          String            @id @default(uuid())
  planId      String
  plan        SharksSupportPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  isMilestone Boolean           @default(false)
  dueOn       DateTime?
  status      SharksTaskStatus  @default(TODO)
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([planId, createdAt])
}

/// Public story of a selected business. Published only from APPROVED, with
/// consent on record and not revoked (lib/sharks/workflow.ts → canPublish).
model SharksStory {
  id            String            @id @default(uuid())
  applicationId String            @unique
  application   SharksApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  slug   String            @unique
  status SharksStoryStatus @default(PROPOSED)

  // Public content
  title           String
  businessName    String
  industry        String
  summary         String
  intro           String?
  challenge       String?
  whySelected     String?
  supportProvided String?
  outcomes        String?
  founderQuote    String?
  founderName     String?
  coverImageUrl   String?
  logoUrl         String?
  /// Show the approved support track on the public page.
  showTrack       Boolean @default(true)

  /// Provider-neutral URL (YouTube, Vimeo, or a direct .mp4/.webm, e.g. Cloudinary).
  videoUrl       String?
  videoPosterUrl String?
  /// Separate switch: the video only shows when this is on AND the story is published.
  videoPublished Boolean @default(false)

  // Consent (from the business, for this story)
  consentGivenAt      DateTime?
  consentGivenBy      String?
  consentMethod       String?
  consentScope        String?
  consentRecordedById String?
  consentRevokedAt    DateTime?

  approvedAt    DateTime?
  approvedById  String?
  publishedAt   DateTime?
  unpublishedAt DateTime?
  archivedAt    DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
}
