model Order {
  id String @id @default(uuid())

  guestSessionId String

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  source        OrderSource @default(ONLINE)
  status        OrderStatus @default(PENDING)
  paymentMethod String

  subtotal    Int
  shipping    Int  @default(0)
  discount    Int  @default(0)
  total       Int
  costTotal   Int?
  profitTotal Int?

  couponCode String?
  notes      String?

  fullName    String
  phone       String
  /// Optional at checkout — order confirmation and status emails go here (lib/notifications/email).
  email       String?
  address     String
  /// Code from constants/egypt-governorates.ts (online checkout); its name is also prefixed to `address`.
  governorate String?
  /// Online checkout only — rate-limits order floods (lib/store/order-rate-limit).
  ipAddress   String?

  /// Fake-order protection (lib/fraud): number reputation at checkout time.
  riskLevel          OrderRiskLevel?
  riskSignals        String[]                @default([])
  /// PENDING = waiting for the customer's phone code; unconfirmed orders expire.
  confirmationStatus OrderConfirmationStatus @default(NOT_REQUIRED)
  confirmedAt        DateTime?
  otpSentCount       Int                     @default(0)
  otpLastSentAt      DateTime?
  /// Set with status CANCELED when the customer refused the delivery (a return).
  /// Kept as a flag so every "not CANCELED" revenue query stays right.
  returnedAt         DateTime?

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  pointsEarned   Int?
  pointsRedeemed Int?

  paymentProvider  String?
  paymentStatus    String?
  paymentReference String?
  paidAt           DateTime?

  posShiftId  String?
  posShift    PosShift? @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  /// Set for POS sales (the branch of the shift). Online orders have no branch.
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashierId   String?
  cashierUser User?     @relation("CashierOrders", fields: [cashierId], references: [id], onDelete: SetNull)

  trackingNumber   String?
  shippingProvider String?
  shippingLabelUrl String?

  createdAt DateTime @default(now())

  items          OrderItem[]
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  suggestedOrder SuggestedOrder?
  splitPayments  PosSplitPayment[]
  posReturns     PosReturn[]       @relation("OriginalOrderReturns")
  shipments      Shipment[]

  @@index([storeId, source, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([guestSessionId, storeId])
  @@index([ipAddress, createdAt])
  @@index([storeId, phone, createdAt])
  @@index([phone])
  @@index([posShiftId])
  @@index([branchId, createdAt])
}

model OrderItem {
